#!/usr/bin/env bash
# Run a throwaway Home Assistant against the integration in this checkout.
#
# The venv already holds a real `hass` (pytest-homeassistant-custom-component
# pins an exact Home Assistant), so this needs no container — which is also why
# Bluetooth works: hass talks to the host's BlueZ over the session D-Bus the
# way a native install does.
set -euo pipefail

cd "$(dirname "$0")/.."
CONFIG="${HASS_CONFIG:-config}"

mkdir -p "$CONFIG/custom_components"

# A symlink, not a copy, so an edit only needs a restart.  Clear the path first:
# ln -sfn would nest the link inside a real directory left by an earlier run.
rm -rf "$CONFIG/custom_components/mammotion"
ln -s "$PWD/custom_components/mammotion" "$CONFIG/custom_components/mammotion"

if [ ! -f "$CONFIG/configuration.yaml" ]; then
  cat > "$CONFIG/configuration.yaml" <<'YAML'
default_config:

logger:
  default: info
  logs:
    custom_components.mammotion: debug
    pymammotion: debug
    homeassistant.components.bluetooth: debug
    habluetooth: debug
    bleak: info
YAML
fi

ENV_ARGS=()
# Any uv sync replaces these with the pinned wheels; relink the sibling checkouts
# when they exist (LOCAL_LIBS=0 to run against the pinned versions instead).
if [ "${LOCAL_LIBS:-1}" != "0" ]; then
  SITE="$(uv run --no-sync python -c 'import sysconfig; print(sysconfig.get_paths()["purelib"])')"
  for lib in pymammotion:../Luba-API pyagorartc:../PyAgoraRTC; do
    name="${lib%%:*}"; src="$(cd "${lib#*:}" 2>/dev/null && pwd)/$name"
    if [ -d "$src" ] && [ "$(readlink "$SITE/$name")" != "$src" ]; then
      rm -rf "$SITE/$name" && ln -s "$src" "$SITE/$name" && echo "linked $name -> $src"
    fi
  done
  # A source checkout's const.py has blank credentials and load_dotenv() searches
  # up from the symlinked path in this venv, so it never finds Luba-API's .env.
  if [ -f ../Luba-API/.env ]; then
    ENV_ARGS=(--env-file "$(cd ../Luba-API && pwd)/.env")
  fi
fi

exec uv run --no-sync "${ENV_ARGS[@]}" hass --config "$CONFIG" --debug "$@"
